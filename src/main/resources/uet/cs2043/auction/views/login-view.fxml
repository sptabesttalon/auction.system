<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uet.cs2043.auction.client.controllers.LoginController"
      stylesheets="@../css/styles.css" styleClass="root-pane">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <Label text="HỆ THỐNG ĐẤU GIÁ TRỰC TUYẾN" styleClass="header-label"/>
    <Label text="UET.CS2043 - Lập trình nâng cao" styleClass="sub-header-label"/>

    <TextField fx:id="txtUsername" promptText="Nhập tên đăng nhập (Bidder)" prefWidth="250"/>
    <PasswordField fx:id="txtPassword" promptText="Mật khẩu (Tùy chọn)" prefWidth="250"/>

    <Button text="Đăng nhập / Bắt đầu" onAction="#handleLogin" prefWidth="250" styleClass="primary-btn"/>
    <Label fx:id="lblMessage" textFill="red"/>
</VBox>